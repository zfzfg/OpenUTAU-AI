<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenUtau.App.ViewModels"
             x:Class="OpenUtau.App.Controls.AssistantMessageCard"
             x:DataType="vm:AssistantMessageViewModel">
  <Border Classes="card">
    <StackPanel Spacing="6">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding DisplayStatus}" Classes="secondary"/>
      </StackPanel>
      <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
      <ItemsControl ItemsSource="{Binding Options}" IsEnabled="{Binding Pending}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AssistantChoiceViewModel">
            <Button Content="{Binding Name}" Tag="{Binding Id}" Click="OnOption" HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel IsVisible="{Binding IsQuestion}" IsEnabled="{Binding Pending}" Spacing="4">
        <TextBox Text="{Binding Answer}" PlaceholderText="{DynamicResource assistant.card.answer}" AutomationProperties.Name="{DynamicResource assistant.card.answer}"/>
        <Button Content="{DynamicResource assistant.card.answer.send}" Click="OnAnswer"/>
      </StackPanel>
      <WrapPanel IsVisible="{Binding IsReview}">
        <Button Content="{DynamicResource assistant.card.apply}" Click="OnApply" IsEnabled="{Binding Pending}" Margin="0,0,4,0"/>
        <Button Content="{DynamicResource assistant.card.reject}" Click="OnReject" IsEnabled="{Binding Pending}" Margin="0,0,4,0"/>
        <Button Content="{DynamicResource assistant.card.show}" Click="OnShow"/>
      </WrapPanel>
      <StackPanel IsVisible="{Binding HasReviewLines}" Spacing="4">
        <ItemsControl ItemsSource="{Binding ReviewLines}">
          <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="11"/></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="‹" Click="OnPrevious" AutomationProperties.Name="{DynamicResource assistant.review.previous}"/>
          <TextBlock Text="{Binding ReviewPageLabel}" VerticalAlignment="Center"/>
          <Button Content="›" Click="OnNext" AutomationProperties.Name="{DynamicResource assistant.review.next}"/>
        </StackPanel>
      </StackPanel>
      <Button Content="{DynamicResource assistant.card.undo}" Click="OnUndo" IsVisible="{Binding CanRevert}"/>
      <WrapPanel IsVisible="{Binding IsAudio}">
        <Button Content="{DynamicResource assistant.card.play}" Click="OnPlay" Margin="0,0,4,0"/>
        <Button Content="{DynamicResource assistant.stop}" Click="OnStop"/>
      </WrapPanel>
      <Expander Header="{DynamicResource assistant.card.details}" IsVisible="{Binding HasDiagnostics}" IsExpanded="False">
        <SelectableTextBlock Text="{Binding Diagnostics}" TextWrapping="Wrap" FontSize="10" MaxHeight="180"/>
      </Expander>
    </StackPanel>
  </Border>
</UserControl>
